          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" edge="1" parent="1" source="node-2" target="node-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" edge="1" parent="1" source="node-3" target="node-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" edge="1" parent="1" source="node-4" target="node-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="" edge="1" parent="1" source="node-5" target="node-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="node-1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;01 Owner opens Share&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Only the project owner can&lt;br&gt;manage members and their&lt;br&gt;roles.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;02 Choose person + role&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Enter an existing account&lt;br&gt;email and choose Editor or&lt;br&gt;Viewer.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-3" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;03 Resolve the account&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Workspace asks Account for&lt;br&gt;the existing user ID by email.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-4" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;04 Store membership&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Save (projectId, userId) and&lt;br&gt;role; reject duplicates or&lt;br&gt;owner changes.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-5" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;05 Show shared projects&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;The member&amp;#x27;s dashboard&lt;br&gt;includes the project with their&lt;br&gt;assigned role.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-6" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;06 Enforce every action&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Workspace permissions also&lt;br&gt;protect internal AI checks&lt;br&gt;and file reads.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-note0" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Owner&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;View, edit, delete, publish and&lt;br&gt;manage project membership.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="node-note1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Editor&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;View, edit, generate, download,&lt;br&gt;view members and delete.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff0eb;strokeColor=#bd6142;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="node-note2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Viewer&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;Read files, download, preview&lt;br&gt;and view members; no writes.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Current role enum allows Editors to soft-delete projects. Only Owners can manage members or publish/unpublish." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="984" width="1080" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="09-publication" name="09  Publish a saved app as a public snapshot">
    <mxGraphModel dx="1200" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1030" math="0" shadow="0">
