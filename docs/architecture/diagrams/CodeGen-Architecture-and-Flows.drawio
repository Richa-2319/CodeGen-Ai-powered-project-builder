        <mxCell id="operator" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Read-only triage evidence&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;HTTP status and narrow service logs&lt;br&gt;projectId + sagaId + topic&lt;br&gt;PENDING status, processed marker, object key&lt;br&gt;Kubernetes readiness / restarts&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#8290A1;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
