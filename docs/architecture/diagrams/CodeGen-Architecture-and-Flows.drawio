        <mxCell id="label-4" value="SSE chunks" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="660" y="900" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="label-5" value="On provider completion:&lt;br&gt;schedule background work" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#B78222;">
          <mxGeometry x="1430" y="685" width="700" height="80" as="geometry" />
        </mxCell>
        <mxCell id="label-6" value="User selects Preview" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="155" y="1290" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="label-7" value="No join waits for storage completion before the original SSE&lt;br&gt;closes. Preview can merge local edits before saved files&lt;br&gt;become available." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#536479;">
