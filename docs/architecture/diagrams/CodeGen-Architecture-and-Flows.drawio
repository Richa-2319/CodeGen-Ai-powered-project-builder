        <mxCell id="edge-6" value="" edge="1" parent="1" source="workspace" target="wdb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#8461B3;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=0;exitX=1;exitY=0.75;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry">
