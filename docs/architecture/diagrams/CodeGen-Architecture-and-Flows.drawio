          <mxGeometry x="60" y="380" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="label2" value="ROUTING, DELIVERY AND OPTIONAL MODULES" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="645" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Java module convention: controller -&amp;gt; service -&amp;gt; repository/entity; resources contain configuration and Flyway migrations." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="1074" width="1080" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="03-authentication" name="03  Signup, login and authenticated requests">
    <mxGraphModel dx="1200" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03  Signup, login and authenticated requests" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=31;fontStyle=1;fontColor=#23364b;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A user identity is created once, then checked again on protected requests." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1080" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" edge="1" parent="1" source="node-1" target="node-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" edge="1" parent="1" source="node-2" target="node-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" edge="1" parent="1" source="node-3" target="node-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" edge="1" parent="1" source="node-4" target="node-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="" edge="1" parent="1" source="node-5" target="node-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="node-1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;01 Use the login form&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;The browser sends signup or&lt;br&gt;login data to /account/auth/.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;02 Pass the public route&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;nginx forwards to the&lt;br&gt;gateway; signup/login do not&lt;br&gt;need a JWT.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-3" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;03 Check the account&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Account service hashes a&lt;br&gt;new password or verifies an&lt;br&gt;existing user.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-4" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;04 Return a signed JWT&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Account service returns the&lt;br&gt;token and a small user&lt;br&gt;profile.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-5" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;05 Remember the login&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;The frontend stores&lt;br&gt;authentication state in&lt;br&gt;browser localStorage.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-6" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;06 Call protected APIs&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Bearer JWT -&amp;gt; gateway -&amp;gt;&lt;br&gt;service security -&amp;gt; project&lt;br&gt;permissions.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-note0" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Internal requests&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;Feign forwards user identity&lt;br&gt;and the internal service header.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="node-note1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Public exceptions&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;Authentication, published-app&lt;br&gt;reads and configured health&lt;br&gt;routes.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="node-note2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;External internal paths&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;The gateway blocks /internal&lt;br&gt;routes from browser callers.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff0eb;strokeColor=#bd6142;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="JWT = signed user identity. A service key identifies internal callers; it does not replace project permissions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="984" width="1080" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="04-project-lifecycle" name="04  Create a project and manage its lifecycle">
    <mxGraphModel dx="1200" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="04  Create a project and manage its lifecycle" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=31;fontStyle=1;fontColor=#23364b;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Workspace owns project records; Account owns plan limits." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1080" height="55" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="" edge="1" parent="1" source="node-1" target="node-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" edge="1" parent="1" source="node-2" target="node-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" value="" edge="1" parent="1" source="node-3" target="node-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" edge="1" parent="1" source="node-4" target="node-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-4" value="" edge="1" parent="1" source="node-5" target="node-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="node-1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;01 Create from&lt;br&gt;dashboard&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:19px;line-height:24px&quot;&gt;POST /workspace/projects with&lt;br&gt;the project name and user JWT.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;02 Enter Workspace&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;The authenticated service&lt;br&gt;resolves the current user.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-3" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;03 Ask Account for limits&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;An internal Feign request&lt;br&gt;retrieves the current&lt;br&gt;subscribed plan.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-4" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;04 Check owned projects&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Compare the owner count&lt;br&gt;with maxProjects; reject&lt;br&gt;when full.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-5" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;05 Save project + owner&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;One workspace transaction&lt;br&gt;stores the project and&lt;br&gt;OWNER membership.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-6" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;06 Open the editor&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Return the project ID and&lt;br&gt;role; the dashboard lists&lt;br&gt;accessible projects.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-note0" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Read and rename&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;Members can read; Owner and&lt;br&gt;Editor can rename and edit.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="node-note1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Delete = soft delete&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;deletedAt hides the project; it&lt;br&gt;also disables future public app&lt;br&gt;reads.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff0eb;strokeColor=#bd6142;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="node-note2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;Download ZIP&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:20px;line-height:25px&quot;&gt;Workspace streams file&lt;br&gt;contents from MinIO with path&lt;br&gt;and size checks.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="700" width="320" height="165" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Creating a project creates metadata. The source files arrive through generation or an authorized file save." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="984" width="1080" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
