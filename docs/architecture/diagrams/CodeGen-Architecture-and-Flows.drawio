        <mxCell id="label-0" value="16 UML use cases: actors, capabilities and role inheritance" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#203247;">
          <mxGeometry x="60" y="34" width="2100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-1" value="Roles apply within one project. The hollow triangle points to the role whose capabilities are inherited." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="98" width="2100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="label-2" value="inherits" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="2040" y="492" width="170" height="42" as="geometry" />
        </mxCell>
        <mxCell id="label-3" value="inherits" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="2040" y="865" width="170" height="42" as="geometry" />
        </mxCell>
        <mxCell id="label-4" value="Read access includes saved files, preview bundles, ZIP&lt;br&gt;downloads and member lists. Sharing grants an existing&lt;br&gt;user membership immediately; there is no invitation&lt;br&gt;acceptance flow." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="485" y="620" width="595" height="145" as="geometry" />
        </mxCell>
        <mxCell id="label-5" value="Create and usage actions require login. Creating a project&lt;br&gt;establishes the caller as OWNER. Editor deletion is&lt;br&gt;implemented behavior; only OWNER manages members or&lt;br&gt;publication." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="485" y="1170" width="595" height="145" as="geometry" />
        </mxCell>
        <mxCell id="label-6" value="Grouped use cases keep this overview readable. The permission table and controller source links define individual operations." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="70" y="1400" width="2080" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
