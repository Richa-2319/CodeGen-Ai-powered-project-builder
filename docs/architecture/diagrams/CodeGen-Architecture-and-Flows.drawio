        <mxCell id="label-0" value="18 UML sequence: prompt checks, model stream and finalization" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#203247;">
          <mxGeometry x="60" y="34" width="2180" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-1" value="Time runs downward. Solid arrows are calls; dashed green arrows return data. The file-storage loop is expanded on page 15." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="98" width="2180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="label-2" value="1 · POST stream (projectId, prompt)" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="174.0" y="293" width="371.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-3" value="2 · Authenticated route" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="570.0" y="395" width="371.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-4" value="3 · Check EDIT permission" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="966.0" y="497" width="371.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-5" value="4 · Allowed / denied" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="966.0" y="599" width="371.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-6" value="5 · Read current plan" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="966.0" y="701" width="767.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-7" value="6 · Plan and daily allowance" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="966.0" y="803" width="767.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-8" value="Intelligence checks today’s usage, then gets or creates the user/project chat session. Denied access or exhausted allowance ends the request." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="450" y="945" width="1760" height="65" as="geometry" />
        </mxCell>
        <mxCell id="label-9" value="7 · Fetch saved file tree" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="966.0" y="1007" width="371.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-10" value="8 · FileTreeDto" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="966.0" y="1109" width="371.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-11" value="9 · System + prompt + project context" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="966.0" y="1211" width="1163.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-12" value="10 · Stream model output" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="966.0" y="1313" width="1163.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-13" value="11 · SSE chunks return through gateway and nginx" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="174.0" y="1415" width="767.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-14" value="Optional tool loop: model read_files → Intelligence → Workspace → saved text. Repeat while the model is generating." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="450" y="1557" width="1760" height="65" as="geometry" />
        </mxCell>
        <mxCell id="label-15" value="Provider completion schedules background work: usage + messages + parsed events → committed PENDING events → Kafka publication (page 15)." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="450" y="1659" width="1760" height="65" as="geometry" />
        </mxCell>
        <mxCell id="label-16" value="SSE completion is separate from durable file completion. Stored chat history is a separate read API; the traced prompt path does not load it as conversation memory." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="1813" width="2180" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
