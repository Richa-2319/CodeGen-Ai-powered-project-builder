        <mxCell id="label-0" value="19 UML sequence: publish a snapshot, then read it anonymously" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#203247;">
          <mxGeometry x="60" y="34" width="2180" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-1" value="HTTP messages shown here pass through nginx and the API gateway. Those transparent hops are omitted for readability." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="98" width="2180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="label-2" value="1 · POST publication" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="174.0" y="293" width="470.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-3" value="Workspace checks OWNER permission, then begins the publication transaction." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="450" y="435" width="1760" height="65" as="geometry" />
        </mxCell>
        <mxCell id="label-4" value="2 · Lock active project; read saved-file metadata" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="669.0" y="497" width="965.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-5" value="3 · Active project + permitted file keys" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="669.0" y="599" width="965.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-6" value="4 · Read saved file bytes" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="669.0" y="701" width="470.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-7" value="5 · Frontend source files" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="669.0" y="803" width="470.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-8" value="6 · Validate entrypoint; save snapshot JSON + active slug" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="669.0" y="905" width="965.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-9" value="7 · Publication committed" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="669.0" y="1007" width="965.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-10" value="8 · Slug/status; UI builds /p/{slug}" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="174.0" y="1109" width="470.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-11" value="9 · GET /workspace/public/apps/{slug}" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="669.0" y="1211" width="1460.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-12" value="10 · Require active publication and nondeleted project" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="669.0" y="1313" width="965.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-13" value="11 · Stored snapshot JSON" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="669.0" y="1415" width="965.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-14" value="12 · Public frontend bundle; render in sandbox" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="669.0" y="1517" width="1460.0" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-15" value="Republish replaces the saved snapshot and preserves the slug. Public reads use that snapshot rather than current MinIO files. Unpublish blocks subsequent public reads." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="1713" width="2180" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
