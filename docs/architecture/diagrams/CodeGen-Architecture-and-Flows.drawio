          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="node-1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;01 Edit or generate&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;The editor holds drafts and&lt;br&gt;recent streamed file updates&lt;br&gt;locally.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;02 Save a file&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:19px;line-height:24px&quot;&gt;PUT&lt;br&gt;/workspace/projects/{id}/files/con&lt;br&gt;tent; requires EDIT permission.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-3" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;03 Persist synchronously&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Workspace normalizes the&lt;br&gt;path, writes MinIO and saves&lt;br&gt;file metadata.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-4" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;04 Fetch a preview&lt;br&gt;bundle&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:18px;line-height:23px&quot;&gt;GET&lt;br&gt;/workspace/projects/{id}/preview&lt;br&gt;reads allowed saved frontend files.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-5" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;05 Prepare current files&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;PreviewPanel merges the&lt;br&gt;saved bundle with recent&lt;br&gt;local file updates.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-6" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;06 Cross the frame&lt;br&gt;boundary&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:18px;line-height:23px&quot;&gt;Send source files + runId by&lt;br&gt;postMessage to&lt;br&gt;sandbox=allow-scripts.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-7" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;07 Compile and resolve&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;The TypeScript compiler&lt;br&gt;resolves relative imports, @/&lt;br&gt;and bundled packages.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-8" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;08 Render the React app&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:19px;line-height:24px&quot;&gt;The frame loads&lt;br&gt;HTML/CSS/modules. Its&lt;br&gt;temporary storage resets on&lt;br&gt;restart.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-9" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;09 Report success or&lt;br&gt;error&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:18px;line-height:23px&quot;&gt;The parent checks frame identity&lt;br&gt;and runId; errors appear in the UI.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff0eb;strokeColor=#bd6142;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Production CSP blocks preview network calls and parent-origin access. Unsupported packages fail clearly; no arbitrary npm install or&lt;br&gt;server process runs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="961" width="1080" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="08-sharing" name="08  Share private access with another account">
    <mxGraphModel dx="1200" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="08  Share private access with another account" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=31;fontStyle=1;fontColor=#23364b;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Sharing grants membership; copying a URL alone does not grant access." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="1080" height="55" as="geometry" />
        </mxCell>
