        <mxCell id="intel" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Intelligence service&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Parses completed FILE_EDIT events.&lt;br&gt;Assigns sagaId and tracks PENDING.&lt;br&gt;Resolves the result by sagaId.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F6F1;strokeColor=#25866B;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="100" y="465" width="430" height="215" as="geometry" />
        </mxCell>
        <mxCell id="workspace" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Workspace service&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Checks processed sagaId.&lt;br&gt;Stores file bytes and metadata.&lt;br&gt;Publishes success or failure.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F6F1;strokeColor=#25866B;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1350" y="465" width="430" height="215" as="geometry" />
        </mxCell>
        <mxCell id="req" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Kafka · file-storage-request-event&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;projectId, sagaId, filePath, content, userId&lt;br&gt;Key: project-{projectId}&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF5DD;strokeColor=#B78222;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="700" y="190" width="550" height="190" as="geometry" />
        </mxCell>
        <mxCell id="resp" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Kafka · file-store-responses&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;sagaId, projectId, success, errorMessage&lt;br&gt;Key: project-{projectId}&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF5DD;strokeColor=#B78222;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="700" y="825" width="550" height="190" as="geometry" />
        </mxCell>
        <mxCell id="idb" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;intelligence_db&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;chat_events: PENDING → CONFIRMED / FAILED&lt;br&gt;Chat messages and usage are also recorded during&lt;br&gt;finalization.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F1EDFB;strokeColor=#8461B3;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="100" y="1125" width="550" height="220" as="geometry" />
        </mxCell>
        <mxCell id="wdb" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;workspace_db&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;project_files: path → object key&lt;br&gt;processed_events: sagaId marker&lt;br&gt;Duplicates skip the write and resend ACK.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F1EDFB;strokeColor=#8461B3;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1250" y="1125" width="550" height="220" as="geometry" />
        </mxCell>
        <mxCell id="minio" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;MinIO · projects&lt;br&gt;bucket&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Object key: projectId/path&lt;br&gt;Object value: source bytes&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F1EDFB;strokeColor=#8461B3;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1850" y="170" width="310" height="215" as="geometry" />
        </mxCell>
        <mxCell id="label-0" value="15 File dataflow: Intelligence → Kafka → Workspace → storage" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#203247;">
          <mxGeometry x="60" y="34" width="2100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-1" value="Follow the numbered arrows around the loop. Gold dashed arrows are Kafka events; purple arrows are storage reads or writes." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="98" width="2100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="label-2" value="2 · Publish file content" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#B78222;">
          <mxGeometry x="340" y="225" width="355" height="50" as="geometry" />
        </mxCell>
        <mxCell id="label-3" value="3 · Consume request" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#B78222;">
          <mxGeometry x="1270" y="225" width="470" height="50" as="geometry" />
        </mxCell>
        <mxCell id="label-4" value="6 · Publish save result" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#B78222;">
          <mxGeometry x="1280" y="855" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="label-5" value="7 · Consume result" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#B78222;">
          <mxGeometry x="425" y="855" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="label-6" value="1 · Commit PENDING before publish&lt;br&gt;8 · Update final status after result" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#8461B3;">
          <mxGeometry x="210" y="1024" width="900" height="90" as="geometry" />
        </mxCell>
        <mxCell id="label-7" value="4 · PUT source bytes" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#8461B3;">
          <mxGeometry x="1805" y="555" width="395" height="50" as="geometry" />
        </mxCell>
        <mxCell id="label-8" value="5 · Read duplicate marker;&lt;br&gt;commit metadata and marker" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#8461B3;">
          <mxGeometry x="1848" y="970" width="365" height="135" as="geometry" />
        </mxCell>
        <mxCell id="label-9" value="Success follows the metadata and marker commits. A&lt;br&gt;storage error produces success=false. A failed ACK&lt;br&gt;send surfaces for retry." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="740" y="455" width="560" height="175" as="geometry" />
        </mxCell>
        <mxCell id="label-10" value="The browser’s SSE stream can finish before this loop.&lt;br&gt;Storage ACKs do not return on that stream. A later&lt;br&gt;Workspace read fetches saved files." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="740" y="642" width="560" height="166" as="geometry" />
        </mxCell>
        <mxCell id="label-11" value="Failure boundary: there is no transactional outbox or atomic transaction across PostgreSQL, Kafka and MinIO. A crash can leave partial progress." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="80" y="1370" width="2100" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
