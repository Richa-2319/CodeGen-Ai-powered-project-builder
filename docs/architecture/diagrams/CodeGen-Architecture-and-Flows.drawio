        <mxCell id="edge-4" value="" edge="1" parent="1" source="node-5" target="node-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0;exitY=0.5;exitPerimeter=1;entryX=1;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-5" value="" edge="1" parent="1" source="node-6" target="node-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="" edge="1" parent="1" source="node-7" target="node-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="" edge="1" parent="1" source="node-8" target="node-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="node-1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;01 Parse completed edits&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Create FILE_EDIT chat&lt;br&gt;events and a unique saga ID&lt;br&gt;for each file.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;02 Commit tracking first&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Persist PENDING events in&lt;br&gt;the intelligence database&lt;br&gt;before publishing.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-3" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;03 Send a Kafka request&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Topic:&lt;br&gt;file-storage-request-event;&lt;br&gt;partition key: project ID.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78222;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-4" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;04 Consume in&lt;br&gt;Workspace&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:18px;line-height:23px&quot;&gt;If sagaId is already processed, skip&lt;br&gt;the write and resend success.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-5" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;05 Write the object&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Save the file under&lt;br&gt;projectId/path in the MinIO&lt;br&gt;projects bucket.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-6" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;06 Commit file metadata&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Save project_files, then&lt;br&gt;processed_events for&lt;br&gt;duplicate detection.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-7" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;07 Send&lt;br&gt;acknowledgement&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:18px;line-height:23px&quot;&gt;Topic: file-store-responses. Failed&lt;br&gt;ACK sends surface for a retry.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78222;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-8" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;08 Resolve the chat event&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Intelligence matches sagaId&lt;br&gt;and sets CONFIRMED or&lt;br&gt;FAILED.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-9" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;09 Read saved content&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;A later file or preview request&lt;br&gt;reads stored metadata and&lt;br&gt;object bytes.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="No transactional outbox or cross-store transaction: a crash can leave partial progress. The acknowledgement is not sent on the original&lt;br&gt;SSE stream." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="961" width="1080" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
