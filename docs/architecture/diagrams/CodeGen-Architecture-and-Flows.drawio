        </mxCell>
        <mxCell id="label-5" value="Responses for non-PENDING events are ignored. No FAILED → PENDING recovery transition is implemented here." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#536479;">
