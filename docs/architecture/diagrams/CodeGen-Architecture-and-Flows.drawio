        </mxCell>
        <mxCell id="label-2" value="No" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#B78222;">
