        <mxCell id="label-16" value="Create establishes an OWNER even though the schema permits zero member&lt;br&gt;rows. Publication shares the project primary key. File uniqueness is (projectId,&lt;br&gt;path)." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="660" y="1435" width="800" height="112" as="geometry" />
        </mxCell>
        <mxCell id="label-17" value="Other domain records: UsageLog stores one user/date token count; ProcessedEvent stores a handled sagaId. See the ER/data ownership view for these tables." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="90" y="1590" width="2020" height="75" as="geometry" />
        </mxCell>
        <mxCell id="label-18" value="Remote userId/projectId and sagaId links are logical references across service-owned databases, not cross-database foreign keys." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="90" y="1675" width="2020" height="45" as="geometry" />
        </mxCell>
