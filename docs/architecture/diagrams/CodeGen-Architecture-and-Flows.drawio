          <mxGeometry x="1100" y="745" width="800" height="45" as="geometry" />
        </mxCell>
        <mxCell id="label-10" value="Deleting the project independently blocks public lookup. It does not explicitly change the publication active flag." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
