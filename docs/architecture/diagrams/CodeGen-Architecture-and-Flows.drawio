        <mxCell id="label-0" value="21 UML activity: user intent, decisions and asynchronous work" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#203247;">
          <mxGeometry x="60" y="34" width="2100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-1" value="Swimlanes assign responsibility. Diamonds are decisions. The UI stream and background file delivery complete independently." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
