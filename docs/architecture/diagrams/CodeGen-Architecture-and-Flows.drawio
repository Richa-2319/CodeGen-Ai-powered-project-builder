        </mxCell>
        <mxCell id="label-4" value="Implemented protections: duplicate-saga detection, explicit success/failure result, surfaced ACK-send failures, readiness/liveness probes and deployment validation scripts." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="80" y="1370" width="2020" height="84" as="geometry" />
        </mxCell>
        <mxCell id="label-5" value="Recommendations: transactional outbox, reconciliation of stuck events and partial file writes, tested backups/restores, dependency resilience and measured SLOs. These are not implemented&lt;br&gt;recovery guarantees." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#536479;">
