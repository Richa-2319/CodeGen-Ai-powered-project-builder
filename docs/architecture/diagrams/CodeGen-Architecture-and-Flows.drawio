        <mxCell id="label-1" value="Transitions are implemented operations. Project and publication states below are derived from records/flags, not additional enum values." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
