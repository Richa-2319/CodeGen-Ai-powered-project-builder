          <mxGeometry x="1530" y="585" width="610" height="190" as="geometry" />
        </mxCell>
        <mxCell id="kubelet" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;kubelet&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Watches assigned Pods and&lt;br&gt;maintains their container lifecycle&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F6F1;strokeColor=#25866B;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="120" y="1010" width="410" height="190" as="geometry" />
        </mxCell>
        <mxCell id="runtime" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Container runtime&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Pulls images and starts containers for the&lt;br&gt;kubelet&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F6F1;strokeColor=#25866B;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="750" y="1010" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="pods" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;CodeGen Pods&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;5 application pods + 4 stateful pods in the demo&lt;br&gt;A separate minio-init Job creates an initialization pod&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#3878C5;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1440" y="1010" width="650" height="190" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Service networking&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;kube-proxy or an equivalent&lt;br&gt;implementation routes ClusterIP Service&lt;br&gt;traffic to Pod endpoints&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#8290A1;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="120" y="1460" width="430" height="205" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Cluster DNS&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Typically CoreDNS resolves service&lt;br&gt;names such as workspace-service&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#8290A1;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="620" y="1460" width="430" height="205" as="geometry" />
        </mxCell>
        <mxCell id="cni" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Pod networking / CNI&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Demo template selects Flannel. It provides&lt;br&gt;connectivity; it does not enforce&lt;br&gt;NetworkPolicies.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#8290A1;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1120" y="1460" width="450" height="205" as="geometry" />
        </mxCell>
        <mxCell id="csi" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;CSI storage integration&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Binds/mounts PVC-backed volumes for&lt;br&gt;PostgreSQL, Kafka and MinIO pods&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F1EDFB;strokeColor=#8461B3;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1640" y="1460" width="450" height="205" as="geometry" />
        </mxCell>
        <mxCell id="label-0" value="26 Kubernetes platform components behind the application" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#203247;">
          <mxGeometry x="60" y="34" width="2100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-1" value="Conceptual Kubernetes / OKE responsibilities. These platform components are managed or supplied by the cluster, not created by CodeGen manifests." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="98" width="2100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="label-2" value="Controller flow: desired objects → reconciliation → scheduling → kubelet → running containers. Application request traffic follows the Services and Ingress shown on&lt;br&gt;page 22." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="135" y="815" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="label-3" value="Ingress controller, metrics collection, centralized logs and backup tooling require explicit setup. Their installation and live health are not verified by these source diagrams." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="70" y="1780" width="2060" height="83" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
