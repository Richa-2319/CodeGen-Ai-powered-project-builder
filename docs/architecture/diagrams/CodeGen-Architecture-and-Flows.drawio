        </mxCell>
        <mxCell id="label-3" value="Yes" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="1130" y="615" width="100" height="45" as="geometry" />
