        <mxCell id="edge-5" value="" edge="1" parent="1" source="node-6" target="node-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-6" value="" edge="1" parent="1" source="node-7" target="node-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-7" value="" edge="1" parent="1" source="node-8" target="node-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2.6;strokeColor=#60778c;dashed=0;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="node-1" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;01 Send a prompt&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;POST&lt;br&gt;/intelligence/chat/stream with&lt;br&gt;projectId and message.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-2" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;02 Verify project access&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Intelligence asks Workspace&lt;br&gt;whether this user can EDIT.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-3" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;03 Check daily allowance&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Read Account plan and&lt;br&gt;today&amp;#x27;s intelligence usage&lt;br&gt;before starting.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="160" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-4" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;04 Prepare the session&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Find/create a project-user&lt;br&gt;chat session; retain caller&lt;br&gt;identity for async work.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f1edfb;strokeColor=#8461b3;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-5" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;05 Build project context&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Fetch the file tree. The model&lt;br&gt;can use read_files for saved&lt;br&gt;file contents.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-6" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;06 Stream from the model&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Spring AI calls the configured&lt;br&gt;compatible provider and&lt;br&gt;model.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78222;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="415" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-7" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;07 Update the editor&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;SSE chunks update chat and&lt;br&gt;parsed file edits in browser&lt;br&gt;memory.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#3878c5;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="60" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-8" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;08 Finish the text stream&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Provider completion ends&lt;br&gt;streaming; it does not prove&lt;br&gt;files are durable.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff5dd;strokeColor=#b78222;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="440" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="node-9" value="&lt;div style=&quot;font-size:23px;font-weight:bold;line-height:28px&quot;&gt;09 Finalize in background&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-size:21px;line-height:26px&quot;&gt;Record usage/messages,&lt;br&gt;parse events, then start the&lt;br&gt;file-delivery flow.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#25866b;strokeWidth=1.8;fontColor=#23364b;fontFamily=Arial;align=left;verticalAlign=top;spacing=18;overflow=hidden;">
          <mxGeometry x="820" y="670" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="SSE = server-sent events. The prompt uses the current message and project files; stored chat history is a separate read API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#526278;" vertex="1" parent="1">
          <mxGeometry x="60" y="984" width="1080" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="06-file-delivery" name="06  Generated files: Kafka, MinIO and acknowledgement">
    <mxGraphModel dx="1200" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1030" math="0" shadow="0">
