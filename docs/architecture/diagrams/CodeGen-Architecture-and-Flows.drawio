        <mxCell id="workspace" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Workspace service :9020&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Creates projects, manages members and&lt;br&gt;reads saved project files&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F6F1;strokeColor=#25866B;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="140" y="785" width="470" height="185" as="geometry" />
        </mxCell>
        <mxCell id="intel" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Intelligence service :9030&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Checks access and allowance; builds project&lt;br&gt;context for the model&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#E8F6F1;strokeColor=#25866B;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1550" y="785" width="470" height="185" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;Every internal request carries identity&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Feign forwards the caller JWT and an internal service&lt;br&gt;header. Async file reads retain the caller JWT explicitly.&lt;br&gt;Workspace still checks project permissions.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#8290A1;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="820" y="520" width="620" height="185" as="geometry" />
        </mxCell>
        <mxCell id="a" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;A · Workspace → Account&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Create project: read maxProjects.&lt;br&gt;Share: resolve an existing email.&lt;br&gt;List members: resolve user details.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#3878C5;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="80" y="1090" width="650" height="210" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;B · Intelligence → Account&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Read the caller’s daily token limit before generation.&lt;br&gt;Intelligence compares it with its own usage records.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#3878C5;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="785" y="1090" width="650" height="210" as="geometry" />
        </mxCell>
        <mxCell id="c" value="&lt;div style=&quot;font-size:25px;font-weight:bold;line-height:31px&quot;&gt;C · Intelligence → Workspace&lt;/div&gt;&lt;div style=&quot;margin-top:12px;font-size:21px;line-height:27px&quot;&gt;Check EDIT permission.&lt;br&gt;Fetch the saved file tree.&lt;br&gt;read_files tool fetches source content.&lt;/div&gt;" vertex="1" parent="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EAF2FF;strokeColor=#3878C5;strokeWidth=2;fontColor=#203247;fontFamily=Arial;align=left;verticalAlign=top;spacing=20;overflow=hidden;">
          <mxGeometry x="1490" y="1090" width="650" height="210" as="geometry" />
        </mxCell>
        <mxCell id="label-0" value="14 Microservice dataflow: direct HTTP requests and responses" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#203247;">
          <mxGeometry x="60" y="34" width="2100" height="54" as="geometry" />
        </mxCell>
        <mxCell id="label-1" value="Blue arrows carry requests. Green arrows carry returned data. These service calls use configured internal URLs, not the public gateway." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="60" y="98" width="2100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="label-2" value="A · GET current plan, user by email / ID" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="350" y="196" width="490" height="42" as="geometry" />
        </mxCell>
        <mxCell id="label-3" value="A · PlanDto / UserDto" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="530" y="443" width="420" height="48" as="geometry" />
        </mxCell>
        <mxCell id="label-4" value="B · GET current plan" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="1340" y="196" width="330" height="42" as="geometry" />
        </mxCell>
        <mxCell id="label-5" value="B · PlanDto with daily token allowance" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="1260" y="443" width="625" height="50" as="geometry" />
        </mxCell>
        <mxCell id="label-6" value="C · GET permission, file tree or file content&lt;br&gt;Inputs: projectId, EDIT permission or file path" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=#FFFFFF;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#3878C5;">
          <mxGeometry x="685" y="744" width="820" height="86" as="geometry" />
        </mxCell>
        <mxCell id="label-7" value="C · Returns allowed/denied, FileTreeDto or saved source text" vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#25866B;">
          <mxGeometry x="680" y="945" width="835" height="76" as="geometry" />
        </mxCell>
        <mxCell id="label-8" value="Account does not call the other two services in these flows. There are no cross-service SQL reads. Exact endpoint paths and payloads are listed in the guide." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=4;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=22;fontStyle=0;fontColor=#536479;">
          <mxGeometry x="80" y="1340" width="2060" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
